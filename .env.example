# PitchRoast environment - copy to .env and fill in your key at check-in:
#     cp .env.example .env
# or let the helper write it for you (it also chmods .env to 600):
#     ./set_key.sh sk-ant-...
# .env is gitignored. Never commit a real key.

# --- Required -----------------------------------------------------------------
# Event / personal Anthropic key. Read by app.py, syndicate.py, run_demo.py and
# test_connection.py via python-dotenv.
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Deliberate: bypass the corporate proxy -----------------------------------
# This project talks to the PUBLIC Anthropic API on purpose, so the Telia
# LiteLLM gateway / internal proxy and any company virtual key are out of the
# path during the hackathon. The Python code pins base_url="https://api.anthropic.com"
# explicitly, so this variable is belt-and-braces: it is what claude_hackathon.sh
# exports for the Claude Code CLI, and it stops a stray ANTHROPIC_BASE_URL in
# your shell profile from redirecting anything. Leave it as-is.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Optional -----------------------------------------------------------------
# Port for the local Arize Phoenix tracing UI. Not read by this project's code,
# but load_dotenv() runs before px.launch_app(), and Phoenix itself reads
# PHOENIX_PORT (defaults to 6006). Set it if 6006 is already taken, and pass the
# same value to the Makefile: make phoenix PHOENIX_PORT=6007
# PHOENIX_PORT=6006
